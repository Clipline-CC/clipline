{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": {
      "script": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-ffmpeg-resource.ps1",
      "cwd": "../.."
    }
  },
  "bundle": {
    "resources": [
      "ffmpeg/",
      "webview2-fixed/Microsoft.WebView2.FixedVersionRuntime.151.0.4129.59.x64/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./webview2-fixed/Microsoft.WebView2.FixedVersionRuntime.151.0.4129.59.x64",
        "silent": null
      }
    }
  }
}
