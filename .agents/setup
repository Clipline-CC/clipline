#!/usr/bin/env bash
set -euo pipefail

step() {
    local label="$1"
    shift
    printf '\n==> %s\n' "$label"
    time "$@"
}

required_packages=(
    binutils
    build-essential
    ca-certificates
    cmake
    curl
    ffmpeg
    git
    pkg-config
)
missing_packages=()
for package in "${required_packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fqx 'install ok installed'; then
        missing_packages+=("$package")
    fi
done

if ((${#missing_packages[@]})); then
    step "Refresh APT metadata" sudo env DEBIAN_FRONTEND=noninteractive apt-get update -y
    step "Install system dependencies: ${missing_packages[*]}" \
        sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        "${missing_packages[@]}"
else
    printf 'System dependencies are already installed.\n'
fi

if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
    step "Install rustup" bash -c \
        'curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none'
fi

# rustup's installer cannot update this already-running process.
# shellcheck disable=SC1091
source "$HOME/.cargo/env"
step "Install stable Rust and clippy" rustup toolchain install stable --profile minimal --component clippy
rustup default stable

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if ! grep -Fq '$HOME/.cargo/env' "$HOME/.bash_profile" 2>/dev/null; then
    printf '\n. "$HOME/.cargo/env"\n' >> "$HOME/.bash_profile"
fi

profile_marker="# Clipline orb Opus target"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ "\${PWD}" == "$repo_root" && -z "\${OPUS_TARGET:-}" ]]; then
    export OPUS_TARGET=ubuntu-22.04_x86_64
fi
EOF
fi

export OPUS_TARGET="${OPUS_TARGET:-ubuntu-22.04_x86_64}"
step "Fetch locked Cargo dependencies" cargo fetch --locked
step "Prebuild workspace tests" cargo test --workspace --no-run --locked

printf '\nClipline orb setup complete.\n'
